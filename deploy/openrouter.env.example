# Server-side only. Never put this key into frontend/VITE_ variables.
OPENROUTER_API_KEY=
NEWSMAP_ENRICHMENT_MODEL=deepseek/deepseek-v3.2
# Lifetime NewsMap enrichment budget; no automatic monthly reset.
NEWSMAP_ENRICHMENT_BUDGET_USD=5
# Start with a small pilot. Raise to 25 after reviewing the results.
NEWSMAP_ENRICHMENT_MAX_EVENTS_PER_RUN=5
